# Website that serves /api/v1.
# Leave this as 127.0.0.1 for the iOS simulator, a phone on the same Wi-Fi, and the Android emulator.
# On a phone, the app replaces 127.0.0.1 with the computer running Metro and calls port 3000.
# On the Android emulator it uses that Metro host, or http://10.0.2.2:3000 when the host is localhost.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
